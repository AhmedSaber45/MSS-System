# Supabase Public Configuration (Exposed to client bundle safely)
NEXT_PUBLIC_SUPABASE_URL=https://ylareolroigqcglayeyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin Dashboard Session Secret (Keep secret in server-side environment / Vercel secrets)
# Generate with `openssl rand -hex 32` or any 32+ character random string
ADMIN_SESSION_SECRET=your_secure_random_session_secret_32_characters_minimum

# Initial Production Super Admin Provisioning (Configured in Vercel / server-side env)
INITIAL_SUPER_ADMIN_USERNAME=saberadmin
INITIAL_SUPER_ADMIN_PASSWORD=your-super-admin-secure-password

# Optional: Supabase Service Role Key (ONLY for privileged server-side operations if configured; NEVER expose with NEXT_PUBLIC_)
# SUPABASE_SERVICE_ROLE_KEY=
